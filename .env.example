# ─── Docker Compose overrides ──────────────────────────────────────────
# Copy this file to .env in the project root and customise as needed.
# docker compose reads .env automatically — no extra flags required.
# ───────────────────────────────────────────────────────────────────────

# Postgres
POSTGRES_VERSION=16
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=crm
POSTGRES_HOST_PORT=5433

# Redis
REDIS_VERSION=7
REDIS_HOST_PORT=6380

# Backend
BACKEND_PORT=8000

# Celery
CELERY_LOG_LEVEL=info

# Frontend
FRONTEND_PORT=3000
