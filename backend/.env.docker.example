# Backend env for Docker Compose — copy to .env.docker and fill in real values.
# NEVER commit .env.docker with real secrets.

DATABASE_URL=postgresql+asyncpg://crm:crm@postgres:5432/crm
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE-ME-use-a-random-64-char-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:3000
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Email (Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL=your-email@example.com
RESEND_FROM_NAME="Your Company Name"
SUPPORT_PHONE="+1 (000) 000-0000"
FRONTEND_URL=https://your-frontend-url.example.com
